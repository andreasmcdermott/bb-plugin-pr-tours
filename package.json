{
  "name": "bb-plugin-pr-tours",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test cli shared viewer && vitest run",
    "test:ui": "vitest run tests/app.spec.tsx",
    "lint": "oxlint . && oxfmt --check .",
    "prepare": "node scripts/build-export.mjs"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.9",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/bun": "^1.3.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^26.0.0",
    "oxfmt": "^0.69.0",
    "oxlint": "^1.84.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.5.9"
  },
  "bb": {
    "name": "PR Tours",
    "description": "Read agent-guided PR tours, review changes, and export a portable HTML copy.",
    "branding": {
      "icon": "GitPullRequest"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  }
}
